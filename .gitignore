# fakestore-k6-load-test — .gitignore
# ─────────────────────────────────────
# Generated report files (future runs ignored automatically)
reports/*.json
reports/*.txt

# Keep the reports directory and committed execution evidence tracked by git
!reports/.gitkeep
!reports/textSummary.txt
!reports/summary.json

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Editor / IDE
.idea/
.vscode/
*.code-workspace

# Node.js (not required — K6 runs JS natively)
node_modules/
package-lock.json
